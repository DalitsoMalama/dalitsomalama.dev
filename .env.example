# Copy to .env.local and fill in once you have a Supabase project + Turnstile keys.
# Leave everything blank to run locally against mock fixture data (see lib/data/fixtures.ts).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Any long random string — salts the hashed IP (rate limiting) and session
# fingerprint (vote dedup) so raw values are never stored. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_HASH_SALT=
